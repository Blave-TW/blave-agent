# 群益本機開通的憑證那一段(0.1.28;renderer/capital_local.js,設計 capital-new-cert-2026-10 §4)。開框讀憑證庫那一下
msgid "capl.looking"
msgstr "正在找這台電腦的群益憑證…"

msgid "capl.none"
msgstr "這台電腦還沒有群益憑證。"

# 申請新憑證那兩步:只講用戶在群益視窗裡會遇到、會猶豫的事
msgid "capl.s1"
msgstr "在群益的視窗用身分證字號登入、輸入手機收到的驗證碼、設一組憑證密碼"

msgid "capl.s2"
msgstr "Windows 跳出「安全性警告」問要不要安裝根憑證時，按「是」"

# 腳那一格(主鈕正上方)。精靈會撤銷舊證是已驗;被撤銷的在別台還能不能登入沒驗,所以「可能」
msgid "capl.revoke"
msgstr "在這台電腦申請新憑證，你在其他電腦上的群益憑證可能會失效。"

# 雲端主機已連群益時取代上面那句(Wei 10-20 拍 A:不擋、字色升一階)
msgid "capl.cloudWarn"
msgstr "申請新憑證會撤銷你現在的群益憑證：雲端主機上的群益會斷線，之後要在雲端重新連接群益。"

msgid "capl.open"
msgstr "開啟憑證精靈"

# 全部過期那一頁的分段鈕第一格(預設選這格)
msgid "capl.renew"
msgstr "展延憑證"

# 已經有憑證那兩步(匯出位置沒驗過,不寫路徑)
msgid "capl.h1"
msgstr "在申請憑證的那台電腦打開群益憑證精靈，按「匯出憑證」"

msgid "capl.h2"
msgstr "把匯出的檔案複製到這台電腦，按「選擇憑證檔案」"

msgid "capl.pick"
msgstr "選擇憑證檔案"

# 選好檔那張卡的副標:不顯示檔名(群益備份檔名含身分證)
msgid "capl.pickedD"
msgstr "在這台電腦匯入，不上傳"

msgid "capl.import"
msgstr "匯入"

# 匯入:這台已有同一個身分證、到期更晚的那張(照 runtime plan_before_import 不匯)
msgid "capl.errOlder"
msgstr "這台電腦已經有一張比較新的群益憑證，這個檔是舊的。"

msgid "capl.expired"
msgstr "這台電腦的群益憑證 {date} 已過期。"

msgid "capl.renewDo"
msgstr "在群益的視窗登入、輸入手機收到的驗證碼。"

# 系統地區(ACP)不是 950。{cp}…{tw} 是 Windows 的選單名,跟著 Windows 的顯示語言、不進 .po
msgid "capl.locale"
msgstr "這台電腦的系統地區不是繁體中文，群益的憑證精靈會變成亂碼。"

msgid "capl.loc1"
msgstr "打開「{cp}」›「{cr}」›「{rg}」"

msgid "capl.loc2"
msgstr "在「{adm}」分頁按「{chg}」，選「{tw}」"

msgid "capl.loc2sub"
msgstr "要系統管理員權限。有些舊程式的字也會跟著變。"

msgid "capl.loc3"
msgstr "重新開機，再回來這裡"

msgid "capl.anyway"
msgstr "還是要開"

msgid "capl.openRegion"
msgstr "開啟地區設定"

# 精靈開著(每 3 秒查憑證庫)
msgid "capl.wait"
msgstr "在群益的視窗完成申請，這裡會自動接著做。"

msgid "capl.waitHint"
msgstr "不要另外用「以系統管理員身分執行」開精靈，憑證可能會放到別的 Windows 帳號。"

msgid "capl.again"
msgstr "再開一次憑證精靈"

msgid "capl.busy"
msgstr "憑證精靈已經開著，在工作列找「群益金融集團憑證精靈」。"

# 開精靈失敗:下載不到/簽章不是程信科技(不執行)/沒打開
msgid "capl.errDl"
msgstr "下載不到群益的憑證精靈。已經幫你開群益憑證專區，從那裡下載。"

msgid "capl.errSig"
msgstr "下載到的憑證精靈沒有群益官方簽章，沒有打開。已開群益憑證專區，從那裡下載。"

msgid "capl.errLaunch"
msgstr "憑證精靈沒有打開。公司電腦的話，可能被安全政策擋下。"

# 新證進庫但私鑰用不了(DPAPI;M0 ①):刻意不給再申請——再申請會再撤銷一次
msgid "capl.noKey"
msgstr "憑證裝好了，但這個 Windows 帳號用不了它的私鑰。"

msgid "capl.found"
msgstr "這台電腦找到群益憑證，到期 {date}。接著填身分證字號和交易密碼。"

msgid "capl.mac"
msgstr "群益需要 Windows。"

# 群益本機帳密表單之後(0.1.28;renderer/capital_local.js)。帳密存在哪(主行程 safeStorage)
msgid "capl.store"
msgstr "身分證字號和交易密碼用 Windows 的加密存在這台電腦，只交給群益下單程式，不會上傳，agent 讀不到。"

# 裝元件那一列在跑時的灰字:缺 VC++ 2010 時會跳一次 UAC(微軟的 redist,簽章先驗)
msgid "capl.setupUac"
msgstr "第一次裝的話，Windows 可能會問要不要讓微軟的 Visual C++ 安裝程式變更裝置，按「是」。"

msgid "capl.s.cert"
msgstr "群益憑證"

# 登入回 600／604、而且庫裡有舊證(照 runtime capital_connect.plan_removals)
msgid "capl.old"
msgstr "這台電腦上還有一張舊的群益憑證，會讓登入失敗。"

msgid "capl.oldRm"
msgstr "刪掉舊的那張"

msgid "capl.oldTitle"
msgstr "刪掉舊的群益憑證"

msgid "capl.oldBody"
msgstr "會刪掉這台電腦上 {n} 張比較舊的群益憑證。"

msgid "capl.oldKeep"
msgstr "到期 {date} 的那張留著。"

msgid "capl.oldOk"
msgstr "刪掉"

msgid "capl.oldFail"
msgstr "舊的憑證沒有刪成，再試一次。"

# 600／604 但沒有舊的可以刪(只剩這張):回到找憑證那一段
msgid "capl.certBad"
msgstr "這台電腦的群益憑證已經過期或被撤銷，要換一張。"

msgid "capl.certAgain"
msgstr "重新找憑證"

# 321(第一次用 API)
msgid "capl.verifyDo"
msgstr "打開群益檢核工具登入，依序按「模擬國內證券下單」「模擬國內期貨下單」「查詢是否已驗證」。"

# 確認帳密／讀取帳戶失敗(這台電腦的版本;雲端那組寫的是「主機」)
msgid "capl.vehicle"
msgstr "這台電腦上的群益登入程式沒有起來。"

msgid "capl.apiVersion"
msgstr "這台電腦上的群益元件太舊，要重裝。"

msgid "capl.reinstall"
msgstr "重新安裝"

msgid "capl.noCreds"
msgstr "這台電腦還沒拿到身分證字號和交易密碼，重填一次交易密碼。"

msgid "capl.busyStep"
msgstr "這台電腦上還有一步在跑，等它跑完再按。"

msgid "capl.generic"
msgstr "這台電腦沒有接受這一步。"

msgid "capl.libOutdated"
msgstr "這台電腦的策略工作區太舊，還不支援群益。更新 Blave 後再試一次。"

# 完成那一態,鈕正上方(spec v2 cap.localOnly):憑證綁在這個 Windows 帳號
msgid "capl.localOnly"
msgstr "Blave 開著、這個 Windows 帳號登入時，群益才會下單。"

# 開精靈前列不出憑證庫(PowerShell 被擋、逾時):不開,免得把庫裡原本那張當成新證
msgid "capl.errList"
msgstr "讀不到這台電腦的憑證庫，先不開精靈（申請完會分不出哪張是新的）。再按一次試試。"

# 結束攔截:群益本機還有部位(主行程填口數;同 pres.quit.body,統一也有部位時兩句接在同一道框)
msgid "capl.quit.body"
msgstr "群益還有 {lots} 口在倉。結束後策略不會再下單，這些部位也不會自動平倉，要自己在群益 app 處理。"

# 結束攔截:群益本機綁著、這一刻讀不到部位、之前也沒讀到過有部位(保守當成可能還有)
msgid "capl.quit.unknown"
msgstr "群益的部位現在讀不到，可能還有在倉。結束後策略不會再下單，也不會自動平倉，請到群益 app 確認。"
