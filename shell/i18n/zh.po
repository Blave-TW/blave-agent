msgid "ws.attachNoImage"
msgstr "{model} 不讀圖"

# title／aria 的長句
msgid "ws.attachNoImageLong"
msgstr "{model} 不讀圖，這張會被略過。"

msgid "ws.attachReadFail"
msgstr "讀不到這個檔案，請重新附加。"

