msgid "cx.chk.incompletePass"
msgstr "The API key, secret key and passphrase have to come together. Not all three arrived, so nothing was saved. Fill in all three and connect again."

msgid "cx.chk.clockCloud"
msgstr "The cloud machine’s clock is out of step with Binance’s, so the key couldn’t be checked and was not saved. Try again in a while; if it keeps happening, contact us."

msgid "cx.chk.networkCloud"
msgstr "The cloud machine couldn’t reach Binance, so the key couldn’t be checked and was not saved. Try again in a while."

msgid "cx.chk.rateCloud"
msgstr "Binance is temporarily limiting requests from the cloud machine, so the key couldn’t be checked and was not saved. Wait a few minutes, then connect again."

msgid "cx.chk.bannedCloud"
msgstr "Binance has temporarily blocked the cloud machine’s IP, so the key couldn’t be checked and was not saved. Wait a while longer, then connect again."

msgid "cx.chk.backoffCloud"
msgstr "The cloud machine was just rate-limited by Binance and is waiting it out, so it didn’t check this time and nothing was saved. Wait a few minutes, then connect again."

msgid "cx.chk.noWhitelistCloud"
