msgid "cx.ip.noneLong"
msgstr "Couldn’t find this computer’s public IP"

msgid "cx.ip.retry"
msgstr "Look Up Again"

msgid "cx.chk.withdraw"
msgstr "This key has withdrawals enabled, so it was not saved. Turn withdrawals off at Binance, then connect again."

msgid "cx.chk.trading"
msgstr "This key has no trading permission, so it was not saved. Usually the IP whitelist is missing: add the IP above to the whitelist, enable trading, then connect again."

msgid "cx.chk.tradingNoIp"
msgstr "This key has no trading permission, so it was not saved. Usually the IP whitelist is missing: set the whitelist, enable trading, then connect again."

msgid "cx.chk.ipOrKey"
msgstr "Binance rejected this key, so it was not saved. Binance doesn’t tell these three causes apart: the IP above isn’t on the whitelist, the API Key was pasted wrong, or the key was deleted. Check the whitelisted IP first."

msgid "cx.chk.keyFormat"
msgstr "The API Key’s format is wrong, so it was not saved. Copy it from Binance again, with no spaces before or after."

msgid "cx.chk.keyFormatV"
msgstr "That key doesn’t look right, so nothing was saved. Copy it from {venue} again, with no spaces before or after."

msgid "cx.chk.rejectedV"
msgstr "{venue} didn’t accept this key, so nothing was saved: {reason}"

msgid "cx.chk.unknownV"
msgstr "{venue} sent back account data that couldn’t be read, so nothing was saved. Try again in a few minutes."

msgid "cx.chk.noCheckV"
msgstr "This version can’t check {venue} keys on this computer yet, so nothing was saved. Update Blave and try again."

msgid "cx.chk.secret"
msgstr "The Secret Key doesn’t match this API Key, so it was not saved. Copy the secret from Binance again. It is shown only once, when the key is created; if you no longer have it, create a new key."

msgid "cx.chk.clock"
msgstr "This computer’s clock is too far off Binance’s, so the key couldn’t be checked and was not saved. Turn on automatic date and time in System Settings, then connect again."

msgid "cx.chk.rate"
msgstr "Binance is temporarily limiting requests from this IP, so the key couldn’t be checked and was not saved. Wait a few minutes before trying again. Repeated retries extend the limit."

msgid "cx.chk.network"
msgstr "Couldn’t reach Binance, so the key couldn’t be checked and was not saved. Check the network, then connect again."

msgid "cx.chk.unknown"
msgstr "Binance returned a result that couldn’t be read, so the permissions couldn’t be confirmed and the key was not saved. Try again in a few minutes."

msgid "cx.chk.noWhitelist"
msgstr "This key has no IP whitelist. Binance deletes keys that have no whitelist and sit unused for 30 days; adding this computer’s public IP to the whitelist is recommended."

msgid "cx.chk.sendFail"
msgstr "The key passed the check but was not saved on this computer ({err}). Connect again."

msgid "cx.gate.checking"
msgstr "Checking this key with {venue}. Usually a few seconds."

msgid "cx.chk.engineTimeout"
msgstr "The order engine on this computer didn't pick this up within 20 seconds; nothing was saved. Connect again; if it keeps happening, restart Blave."

msgid "cx.chk.gateSlow"
msgstr "{venue} hasn't replied within 20 seconds; the key may still be under check. Don't re-paste yet: look for {venue} under Settings › Account, and connect again if it doesn't show up."

msgid "cx.re.tradingOff"
msgstr "Trading permission was turned off, so orders can’t be placed. Turn it back on at Binance, then press Retest connection."

msgid "cx.re.ipChanged"
msgstr "The public IP changed. Update the whitelist at Binance to the IP below, then press Retest connection."

msgid "cx.re.rejected"
msgstr "Binance rejected this key, so orders can’t be placed. Check the whitelisted IP. If the key is gone, reconnect."

msgid "tm.key.ipTitle"
msgstr "{where}: public IP changed"

msgid "tm.key.ipBody"
msgstr "Update the Binance whitelist to {ip}, then press Retest connection in Auto trading › Settings. Orders can’t be placed until then."

msgid "tm.key.rejTitle"
msgstr "{where}: Binance rejected the key"

msgid "tm.key.rejSameIpBody"
msgstr "Check at Binance that the key still exists and its permissions are unchanged. If it’s gone, create a new one, then unbind and reconnect in Auto trading › Settings. Orders can’t be placed until then."

msgid "tm.key.rejUnknownBody"
msgstr "Open Auto trading › Settings to check the IP and the key: the public IP may have changed, or the key may have been deleted. Orders can’t be placed until then."

msgid "tm.key.permTitle"
msgstr "{where}: trading was turned off for the Binance key"

msgid "tm.key.permBody"
msgstr "Turn trading permission back on for this key at Binance, then press Retest connection in Auto trading › Settings. Orders can’t be placed until then."

msgid "tr.hostLock"
msgstr "The previous order engine is still shutting down; retrying automatically ({n}/{max}). No orders go out meanwhile."

msgid "cx.re.badKey"
msgstr "The key saved on this computer no longer matches Binance (the secret or the API Key is wrong), so orders can’t be placed. Press Unbind, then connect again."

msgid "cx.note.noFutures"
msgstr "This key has no futures trading permission: spot strategies can trade, but Binance will reject orders from futures strategies. To run futures strategies, enable it at Binance, then press Retest connection. If it can’t be enabled (keys created before you opened a futures account can’t), create a new key and connect again."

msgid "cx.note.noSpot"
msgstr "This key has no spot trading permission: futures strategies can trade, but Binance will reject orders from spot strategies. To run spot strategies, enable it at Binance, then press Retest connection. If it can’t be enabled, create a new key and connect again."

msgid "cx.ip.copyThis"
msgstr "Copy this IP"

