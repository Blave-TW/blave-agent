msgstr "This deletes the {source} key from this computer. It can’t be undone; to use it again you paste the key in again."

msgid "src.delBody2"
msgstr "Used by: {names}. After deletion they can’t fetch this data in backtests or live runs."

msgid "src.delBlocked"
msgstr "It can’t be deleted right now. {name} is trading and uses {source}; without the key its next run can’t fetch the data. Set that strategy’s amount to 0 under Auto trading › Positions first, then come back."

msgid "src.gotIt"
msgstr "Got It"

msgid "src.lead"
msgstr "Keys for data services you signed up for yourself (such as FRED or Coinglass) go here; strategies use them to fetch data. They are stored in the workspace on this computer, where the agent and your strategy code can read them. They are never used to place orders."

msgid "src.empty1"
msgstr "Blave’s built-in data needs no key. Add something here only when a strategy uses another provider’s data and that provider requires your own key."

msgid "src.empty2"
msgstr "Once it’s added, just tell the agent to “use {ex} data”. Don’t paste the key into the chat."

msgid "src.rowLocal.one"
msgstr "{n} field · used by: {names}"

msgid "src.rowLocal.other"
msgstr "{n} fields · used by: {names}"

msgid "src.rowLocalNone.one"
msgstr "{n} field · not used by any strategy yet"

msgid "src.rowLocalNone.other"
msgstr "{n} fields · not used by any strategy yet"

msgid "src.rmField"
msgstr "Remove this field"

msgid "src.errValue"
msgstr "The value for {field} contains characters that can’t be used: letters, digits and symbols only — no spaces, non-ASCII characters, single quotes, backslashes or ${. Check that you pasted the key itself."

msgid "src.errFieldReserved"
msgstr "The field name {field} can’t be used with this source. Choose another, such as TOKEN."

msgid "src.errBusy"
msgstr "The workspace settings file is in use, so nothing was saved. Wait a few seconds and try again."

msgid "src.cloudLead"
msgstr "These are the data sources on your cloud machine; only names are listed. This version can’t add or delete them here."

msgid "src.cloudEmpty"
msgstr "There are no data sources on the cloud machine."

msgid "ho.up.btn"
msgstr "Send to Cloud"

msgid "ho.down.btn"
msgstr "Bring Back"

msgid "ho.down.aria"
msgstr "Bring back to this computer"

msgid "ho.up.title"
msgstr "Send to Cloud: {id}"

msgid "ho.down.title"
msgstr "Bring Back to This Computer: {id}"

msgid "ho.row.moves"
msgstr "Moves"

msgid "ho.row.movesV"
msgstr "Strategy code"

msgid "ho.row.movesKeys"
msgstr "Strategy code, and the data-source keys it uses ({sources})"

msgid "ho.row.movesMaybe"
msgstr "Strategy code, and the data-source keys it uses (if any)"

msgid "ho.row.stays"
msgstr "Doesn’t move"

msgid "ho.row.staysV"
msgstr "Exchange keys, amounts, trading state"

msgid "ho.over.up"
msgstr "Replaces the strategy with the same name in the cloud."

msgid "ho.over.down"
msgstr "Replaces the strategy with the same name on this computer."

msgid "ho.over.maybeUp"
msgstr "If the cloud already has a strategy with this name, it is replaced."

msgid "ho.block.up"
msgstr "The one in the cloud is trading and can’t be replaced. Pause it there and set its amount to 0 first."

msgid "ho.block.down"
msgstr "The one on this computer is trading and can’t be replaced. Pause it and set its amount to 0 first."

msgid "ho.block.goCloud"
msgstr "View in Cloud"

msgid "ho.block.goLocal"
msgstr "View on This Computer"

msgid "ho.note"
msgstr "The agent takes it from here and reports progress in the chat."

msgid "ho.ok"
msgstr "Confirm"

msgid "ho.emptyHint"
msgstr "No strategies in the cloud yet. Open one on this computer and press Send to Cloud."

msgid "ho.ready.h"
msgstr "Your cloud machine is ready"

msgid "ho.ready.body"
msgstr "Go back to this computer and press Send to Cloud to put {id} up there."

msgid "ho.ready.stay"
msgstr "Stay in the Cloud"

msgid "ho.gate.stale"
msgstr "The cloud’s state can’t be read right now, so this isn’t being sent."

msgid "ho.gate.stopped"
msgstr "Your cloud machine is stopped, so nothing can be sent up right now."

msgid "ho.back.btn"
msgstr "Back to This Computer"

msgid "ho.msg.up"
msgstr "Send the strategy {id} to my cloud machine. Re-run the backtest there once it’s moved, and show me both sets of numbers side by side."

msgid "ho.msg.down"
msgstr "Bring the strategy {id} from my cloud machine back to this computer. Re-run the backtest here afterwards, and show me both sets of numbers side by side."
