# 回測指標的 tooltip(定義照 lib/analysis.py、lib/runner.py 的算法)
msgid "bt.tip.totalReturn"
msgstr "Cumulative return over the whole backtest, net of fees."

msgid "bt.tip.annReturn"
msgstr "Total return converted to a compounded yearly rate, so backtests of different lengths can be compared."

msgid "bt.tip.benchmark"
msgstr "What buying and holding this symbol over the same period would have returned. The strategy has to beat it to be better than doing nothing."

msgid "bt.tip.benchmarkRank"
msgstr "Share of randomly picked buy-and-hold portfolios that this strategy’s total return beats."

msgid "bt.tip.annVol"
msgstr "Standard deviation of daily returns, scaled to a year. Higher means a bumpier equity curve."

msgid "bt.tip.maxDrawdown"
msgstr "Largest fall from a peak to the lowest point after it — how much you would have been down at the worst moment."

msgid "bt.tip.sharpe"
msgstr "Return earned per unit of volatility (annualized, risk-free rate taken as 0). Higher is better."

msgid "bt.tip.sortino"
msgstr "Same as Sharpe, but only downside volatility counts as risk; upside swings are not penalized."

msgid "bt.tip.omega"
msgstr "Sum of all gains divided by sum of all losses. Above 1 means it made more than it lost."

msgid "bt.tip.trades"
msgstr "Number of position changes: each entry, exit, or resize counts once."

msgid "bt.tip.winRate"
msgstr "Share of days with a gain, among days that had any P&L. This is not a per-trade win rate."

msgid "bt.tip.totalFees"
msgstr "All fees paid over the period, as a percentage of capital."

